# Copy this file to .env.local and fill in real values. Never commit .env.local.

# OpenAI-compatible chatbot provider. Keep these server-side.
# Groq free plan example:
# AI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-20b
#
# OpenAI example:
OPENAI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Used by app/api/contact/route.ts to deliver contact form submissions.
#
# Free personal-email SMTP example for Gmail:
# 1. Enable 2-Step Verification on the Gmail account.
# 2. Create a Gmail App Password.
# 3. Use the app password below, not your normal email password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
CONTACT_TO_EMAIL=your-email@gmail.com
CONTACT_FROM_EMAIL=Portfolio <your-email@gmail.com>

# Optional Resend fallback, only if you decide to use Resend later.
RESEND_API_KEY=
